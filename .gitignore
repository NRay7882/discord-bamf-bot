# Dependencies
node_modules/

# Environment / secrets - real secrets are injected at runtime via 1Password (op).
# Only .env.example (op:// references, no secrets) is tracked.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/

# Python module artifacts (modules may be written in Python)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE (keep shared VS Code config if you add it)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Claude Code - CLAUDE.md and shared settings stay tracked; local overrides do not
.claude/settings.local.json
