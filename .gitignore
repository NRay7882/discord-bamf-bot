# Dependencies
node_modules/

# Runtime state (per-guild module config, e.g. thread-directory). Never committed.
data/

# Environment / secrets - .env holds real values and is never committed.
# Only .env.example (placeholders, no secrets) is tracked.
.env
.env.*
!.env.example

# Operator override for module scoping / access. Holds server-specific guild and
# role IDs, so it is never committed. Only bamf.local.example.json is tracked.
bamf.local.json

# private testing notes.
extras/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/

# Python module artifacts (modules may be written in Python)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE (keep shared VS Code config if you add it)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Claude Code - CLAUDE.md and shared settings stay tracked; local overrides do not
.claude/settings.local.json
