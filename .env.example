# BamfBot environment. Copy this file to .env and fill in real values:
#   copy .env.example .env      (Windows)      cp .env.example .env  (macOS/Linux)
#
# .env is gitignored and must never be committed. The app loads it automatically
# at startup (see src/config.js), so a plain `node` / `npm start` picks it up.
# Anything already set in the environment takes precedence over this file.

# Each environment (dev, prod) is a SEPARATE Discord application, so it has its
# own three values below. Keep a separate working copy per environment (a
# `git worktree` is ideal), each with its own .env: the dev copy holds the dev
# app's token/ID + your test server; the prod copy holds the prod app's. See
# docs/HOSTING.md ("Running dev and prod side by side").

# The bot token (the bot's password). Keep it secret.
DISCORD_TOKEN=your-bot-token

# The application (client) ID - used when registering slash commands.
DISCORD_CLIENT_ID=your-application-id

# The test/home server (guild) ID - guild-scoped command registration is instant
# (dev registers here; prod registers commands globally and does not need this).
DISCORD_GUILD_ID=your-test-server-id

# --- Non-secret runtime config (safe defaults; override as needed) ---

# Which environment this instance is: prod (default) or dev. When you run prod
# and dev on one host under PM2, ecosystem.config.cjs sets this and the port
# offset below for you (via BAMF_ENV at `pm2 start`) - you normally don't set
# these two by hand. They're documented here for non-PM2 runs.
# BAMF_ENV=prod

# Port offset the core adds when reaching HTTP modules, so a second (dev) stack
# can run beside prod without colliding: with 1000, a module's :8082 becomes
# :9082. The module process must listen on the shifted port too (PM2 sets its
# PORT from the same offset). Leave 0 for a single environment.
# BAMF_MODULE_PORT_OFFSET=0

# Replace the host the core uses to reach modules (default: each module's
# manifest host, normally localhost). For a containerized stack, set this to a
# service name so the core addresses modules by name instead of localhost.
# BAMF_MODULE_HOST=

# How long (ms) the core waits for a module's /invoke before giving up.
# MODULE_TIMEOUT_MS=8000

# Optional shared secret sent as the "x-bamf-secret" header on every module
# call. If set, modules that check it will reject calls from anyone else.
# Leave unset for local dev.
# BAMF_SHARED_SECRET=

# Log level: debug | info | warn | error  (default: info)
# LOG_LEVEL=info

# --- Module scoping and on/off (never committed; guild IDs stay out of the repo) ---

# Turn modules off entirely, by name, comma-separated.
# BAMF_DISABLED_MODULES=some-module,another-module

# Allow a RESTRICTED module ("scope": { "restricted": true } in its manifest) in
# specific servers, by guild ID. One variable per module: BAMF_SCOPE_<MODULE>,
# where <MODULE> is the module name upper-cased with non-alphanumerics as "_".
# A restricted module with no allowlist is available in NO server.
# Example, for a module named "my-community-thing":
# BAMF_SCOPE_MY_COMMUNITY_THING=111111111111111111,222222222222222222
#
# The astrogoblin module ships restricted; allow it in your server(s) by ID.
# For dev, this is usually the same value as DISCORD_GUILD_ID above.
# BAMF_SCOPE_ASTROGOBLIN=111111111111111111
#
# Optional: override the default magnifying-glass title emoji with a custom one,
# as its full token <:name:id> (server-specific, so it stays here, not the repo).
# IMPORTANT: a custom emoji only renders on servers the bot is a member of -
# anywhere else it shows as raw text. Leave this unset to use the default 🔍.
# ASTROGOBLIN_TITLE_EMOJI=<:goblin:123456789012345678>
#
# For server-name matching and per-guild role-ID overrides, use bamf.local.json
# (see bamf.local.example.json).
