# BamfBot environment - 1Password references only. No real secrets in this file.
# Copy to .env and resolve at runtime with:  op run --env-file=.env -- <command>
#
# The dev secret lives in the 1Password item "BamfBot-Dev" (vault "Personal"),
# with the credential fields under a section labeled "add more".

# The bot token (the bot's password). Never commit the resolved value.
DISCORD_TOKEN=op://Personal/BamfBot-Dev/add more/Token

# The application (client) ID - used when registering slash commands.
DISCORD_CLIENT_ID=op://Personal/BamfBot-Dev/add more/ApplicationID

# The test server (guild) ID - guild-scoped command registration is instant.
DISCORD_GUILD_ID=op://Personal/BamfBot-Dev/add more/ServerID

# --- Non-secret runtime config (safe defaults; override as needed) ---

# How long (ms) the core waits for a module's /invoke before giving up.
# MODULE_TIMEOUT_MS=8000

# Optional shared secret sent as the "x-bamf-secret" header on every module
# call. If set, modules that check it will reject calls from anyone else.
# Leave unset for local dev. Use an op:// reference in production.
# BAMF_SHARED_SECRET=

# Log level: debug | info | warn | error  (default: info)
# LOG_LEVEL=info
