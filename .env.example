# BamfBot environment. Copy this file to .env and fill in real values:
#   copy .env.example .env      (Windows)      cp .env.example .env  (macOS/Linux)
#
# .env is gitignored and must never be committed. The app loads it automatically
# at startup (see src/config.js), so a plain `node` / `npm start` picks it up.
# Anything already set in the environment takes precedence over this file.

# The bot token (the bot's password). Keep it secret.
DISCORD_TOKEN=your-bot-token

# The application (client) ID - used when registering slash commands.
DISCORD_CLIENT_ID=your-application-id

# The test server (guild) ID - guild-scoped command registration is instant.
DISCORD_GUILD_ID=your-test-server-id

# --- Non-secret runtime config (safe defaults; override as needed) ---

# How long (ms) the core waits for a module's /invoke before giving up.
# MODULE_TIMEOUT_MS=8000

# Optional shared secret sent as the "x-bamf-secret" header on every module
# call. If set, modules that check it will reject calls from anyone else.
# Leave unset for local dev.
# BAMF_SHARED_SECRET=

# Log level: debug | info | warn | error  (default: info)
# LOG_LEVEL=info

# --- Module scoping and on/off (never committed; guild IDs stay out of the repo) ---

# Turn modules off entirely, by name, comma-separated.
# BAMF_DISABLED_MODULES=some-module,another-module

# Allow a RESTRICTED module ("scope": { "restricted": true } in its manifest) in
# specific servers, by guild ID. One variable per module: BAMF_SCOPE_<MODULE>,
# where <MODULE> is the module name upper-cased with non-alphanumerics as "_".
# A restricted module with no allowlist is available in NO server.
# Example, for a module named "my-community-thing":
# BAMF_SCOPE_MY_COMMUNITY_THING=111111111111111111,222222222222222222
#
# For server-name matching and per-guild role-ID overrides, use bamf.local.json
# (see bamf.local.example.json).
