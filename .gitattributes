# Normalize line endings so Windows (PC) and macOS (M5) don't fight over CRLF/LF.
* text=auto eol=lf

# Keep Windows script types as CRLF if any are ever added.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Treat common binaries as binary (no EOL conversion).
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
